########################################
# GLOBAL
########################################

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
*.swp

# Editors
.vscode/
.idea/
*.iml

########################################
# APPS (Expo React Native + Node API)
########################################

# Node dependencies
apps/mobile/node_modules/
apps/api/node_modules/
packages/**/node_modules/
node_modules/
apps/mobile/expo-env.d

# Expo build artifacts
apps/mobile/.expo/
apps/mobile/.expo-shared/
apps/mobile/.expo-dev/
apps/mobile/.expo/web/cache/
apps/mobile/.expo/web/cache/development/

# Metro bundler cache
apps/mobile/.metro/
apps/mobile/.cache/

# Build outputs
apps/mobile/dist/
apps/mobile/build/
apps/mobile/web-build/
apps/mobile/.expo-build/

# iOS native folders (if generated)
apps/mobile/ios/
# but keep Podfile etc. only if this is a bare RN project (yours isn’t)

# Android native folders (if generated)
apps/mobile/android/

# Typescript build info
apps/mobile/*.tsbuildinfo

########################################
# BACKEND (Node + Express)
########################################

# Environment vars
apps/api/.env
.env        # root-level .env if any
.env.*

# Uploads (temporary, not committed)
apps/api/uploads/

# Build outputs
apps/api/dist/
apps/api/logs/

# Package manager garbage
apps/api/npm-debug.log
apps/api/yarn.lock

ai-engine/test_video/*
ai-engine/knowlegde/*
ai-engine/*.json
ai-engine/.env

########################################
# MISC
########################################

*.tmp
temp/
tmp/
*.pyc
ai-engine/evidence.jpg