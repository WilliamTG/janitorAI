########################################
# GLOBAL
########################################

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
*.swp

# Editors
.vscode/
.idea/
*.iml

########################################
# FRONTEND (Expo React Native)
########################################

# Node dependencies
frontend/node_modules/

# Expo build artifacts
frontend/.expo/
frontend/.expo-shared/
frontend/.expo-dev/
frontend/.expo/web/cache/
frontend/.expo/web/cache/development/

# Metro bundler cache
frontend/.metro/
frontend/.cache/

# Build outputs
frontend/dist/
frontend/build/
frontend/web-build/
frontend/.expo-build/

# iOS native folders (if generated)
frontend/ios/
# but keep Podfile etc. only if this is a bare RN project (yours isn’t)

# Android native folders (if generated)
frontend/android/

# Typescript build info
frontend/*.tsbuildinfo

########################################
# BACKEND (Node + Express)
########################################

# Node dependencies
backend/node_modules/

# Environment vars
backend/.env
.env        # root-level .env if any
.env.*

# iOS certificates and provisioning profiles
*.p12
*.cer
*.mobileprovision
*.certSigningRequest

# Android keystore files
*.keystore
*.jks

# Uploads (temporary, not committed)
backend/uploads/

# Build outputs
backend/dist/
backend/logs/

# Package manager garbage
backend/npm-debug.log
backend/yarn.lock

########################################
# MISC
########################################

*.tmp
temp/
tmp/
